{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dahun428-fx/ocr_test_repo/schemas/2.0.0/raw-payload.schema.json",
  "title": "rawPayload",
  "description": "원문 저장 기록. 추적에는 원문을 넣지 않으므로 여기에 두고 해시로 참조합니다. 저장소에 올리지 않고 사용자 PC에만 둡니다.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "2.0.0",
      "description": "이 기록이 따르는 스키마 묶음의 버전."
    },
    "recordType": {
      "const": "rawPayload",
      "description": "기록 종류. JSONL 한 파일에 여러 종류가 섞여도 구분할 수 있게 합니다."
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$",
      "description": "실행 묶음 id."
    },
    "traceId": {
      "type": "string",
      "pattern": "^(?!0{32})[a-f0-9]{32}$",
      "description": "이 원문이 나온 실행의 추적 id."
    },
    "spanId": {
      "type": "string",
      "pattern": "^(?!0{16})[a-f0-9]{16}$",
      "description": "이 원문이 나온 span의 id."
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "content의 SHA-256 (ocr_harness.ids.content_digest). span은 `raw://` + 이 값으로 참조합니다."
    },
    "kind": {
      "enum": [
        "ocr_output",
        "retrieval_query",
        "input_messages",
        "output_messages",
        "postprocess_output"
      ],
      "description": "원문의 종류."
    },
    "content": {
      "description": "원문. input_messages와 output_messages는 OTel GenAI 규약의 메시지 JSON 스키마 구조(role, parts)를 따르고, 나머지는 글자열입니다."
    },
    "retention": {
      "oneOf": [
        {
          "const": "study"
        },
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      ],
      "description": "보존 기한. 날짜(YYYY-MM-DD) 또는 연구 기간 동안(study)."
    }
  },
  "required": [
    "schemaVersion",
    "recordType",
    "runId",
    "traceId",
    "spanId",
    "digest",
    "kind",
    "content",
    "retention"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "input_messages"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "https://raw.githubusercontent.com/open-telemetry/semantic-conventions-genai/76e0c19e7fe1/model/gen-ai/gen-ai-input-messages.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "output_messages"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "https://raw.githubusercontent.com/open-telemetry/semantic-conventions-genai/76e0c19e7fe1/model/gen-ai/gen-ai-output-messages.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "ocr_output",
              "retrieval_query",
              "postprocess_output"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "type": "string"
          }
        }
      }
    }
  ]
}
