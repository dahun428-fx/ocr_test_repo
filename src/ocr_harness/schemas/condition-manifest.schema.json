{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "conditionManifest",
  "description": "조건 하나의 불변 선언. 이 기록의 해시가 manifestDigest입니다.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "recordType": {
      "const": "conditionManifest"
    },
    "conditionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "model": {
      "type": "object",
      "properties": {
        "requestModel": {
          "type": "string",
          "minLength": 1
        },
        "authRoute": {
          "enum": [
            "subscription_oauth",
            "api_key",
            "fake"
          ]
        }
      },
      "required": [
        "requestModel",
        "authRoute"
      ],
      "additionalProperties": false
    },
    "components": {
      "type": "object",
      "properties": {
        "ocr": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9.-]{1,63}$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                }
              },
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": false
            }
          ]
        },
        "retrieval": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9.-]{1,63}$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                }
              },
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": false
            }
          ]
        },
        "context": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9.-]{1,63}$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                }
              },
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": false
            }
          ]
        },
        "history": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9.-]{1,63}$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                }
              },
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": false
            }
          ]
        },
        "postprocess": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9.-]{1,63}$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                }
              },
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "ocr",
        "retrieval",
        "context",
        "history",
        "postprocess"
      ],
      "additionalProperties": false
    },
    "promptTemplateDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "knowledgeIndexVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sdk": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "cliVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "required": [
        "name",
        "version",
        "cliVersion"
      ],
      "additionalProperties": false
    },
    "policyVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "platformContractVersion": {
      "const": "0.2.0"
    },
    "semconvCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{7,40}$"
    }
  },
  "required": [
    "schemaVersion",
    "recordType",
    "conditionId",
    "version",
    "model",
    "components",
    "promptTemplateDigest",
    "sdk",
    "policyVersion",
    "platformContractVersion",
    "semconvCommit"
  ],
  "additionalProperties": false
}
