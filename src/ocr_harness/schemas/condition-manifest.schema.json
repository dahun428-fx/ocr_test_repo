{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dahun428-fx/ocr_test_repo/schemas/2.1.0/condition-manifest.schema.json",
  "title": "conditionManifest",
  "description": "실험 조건 하나의 불변 선언. 실험 설정에는 공통 표준이 없어 구조는 자체 정의입니다. 이 기록을 RFC 8785로 정규화한 JSON의 SHA-256이 manifestDigest입니다 (ocr_harness.common.ids.manifest_digest).",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "2.1.0",
      "description": "이 기록이 따르는 스키마 묶음의 버전."
    },
    "recordType": {
      "const": "conditionManifest",
      "description": "기록 종류. JSONL 한 파일에 여러 종류가 섞여도 구분할 수 있게 합니다."
    },
    "conditionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$",
      "description": "조건 id (c0~c4, ck 등). 닫힌 목록이 아닙니다."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "조건 선언의 버전. 플랫폼 evaluation 계약의 agentVersion에 들어갑니다."
    },
    "model": {
      "type": "object",
      "properties": {
        "requestModel": {
          "type": "string",
          "minLength": 1,
          "description": "요청할 모델 id (OTel gen_ai.request.model과 같은 값)."
        },
        "authRoute": {
          "enum": [
            "subscription_oauth",
            "api_key",
            "fake"
          ],
          "description": "인증 경로. 구독, API 키, 가짜 모델의 결과를 섞지 않기 위해 적습니다."
        }
      },
      "required": [
        "requestModel",
        "authRoute"
      ],
      "additionalProperties": false,
      "description": "모델 설정."
    },
    "components": {
      "type": "object",
      "properties": {
        "ocr": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9.-]{1,63}$",
                  "description": "구현 id."
                },
                "version": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                  "description": "구현 버전."
                }
              },
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": false
            }
          ],
          "description": "OCR 엔진. 쓰지 않으면 null (키는 생략할 수 없습니다)."
        },
        "retrieval": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9.-]{1,63}$",
                  "description": "구현 id."
                },
                "version": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                  "description": "구현 버전."
                }
              },
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": false
            }
          ],
          "description": "검색. 쓰지 않으면 null (키는 생략할 수 없습니다)."
        },
        "context": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9.-]{1,63}$",
                  "description": "구현 id."
                },
                "version": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                  "description": "구현 버전."
                }
              },
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": false
            }
          ],
          "description": "컨텍스트 구성. 쓰지 않으면 null (키는 생략할 수 없습니다)."
        },
        "history": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9.-]{1,63}$",
                  "description": "구현 id."
                },
                "version": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                  "description": "구현 버전."
                }
              },
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": false
            }
          ],
          "description": "이력 선별. 쓰지 않으면 null (키는 생략할 수 없습니다)."
        },
        "postprocess": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9.-]{1,63}$",
                  "description": "구현 id."
                },
                "version": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                  "description": "구현 버전."
                }
              },
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": false
            }
          ],
          "description": "출력 후처리. 쓰지 않으면 null (키는 생략할 수 없습니다)."
        }
      },
      "required": [
        "ocr",
        "retrieval",
        "context",
        "history",
        "postprocess"
      ],
      "additionalProperties": false,
      "description": "하네스 단계별 구현."
    },
    "promptTemplateDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "프롬프트 틀의 SHA-256."
    },
    "knowledgeIndexVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "검색 색인의 버전. 검색을 쓰지 않으면 생략합니다."
    },
    "sdk": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "SDK 이름."
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "SDK 버전."
        },
        "cliVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "CLI 버전."
        }
      },
      "required": [
        "name",
        "version",
        "cliVersion"
      ],
      "additionalProperties": false,
      "description": "모델 호출에 쓰는 SDK. 버전에 따라 숨은 컨텍스트가 달라져 고정합니다."
    },
    "policyVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "플랫폼 evaluation 계약의 필수 값. 이 연구에서는 0.0.0으로 고정합니다."
    },
    "platformContractVersion": {
      "const": "0.2.0",
      "description": "가져온 플랫폼 계약의 버전."
    },
    "semconvCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{7,40}$",
      "description": "속성 이름의 근거로 삼은 OTel GenAI 시맨틱 규약의 커밋."
    }
  },
  "required": [
    "schemaVersion",
    "recordType",
    "conditionId",
    "version",
    "model",
    "components",
    "promptTemplateDigest",
    "sdk",
    "policyVersion",
    "platformContractVersion",
    "semconvCommit"
  ],
  "additionalProperties": false
}
