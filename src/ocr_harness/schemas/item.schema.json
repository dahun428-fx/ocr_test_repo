{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "item",
  "description": "평가 항목 한 건. 촬영자 개인정보는 수집 단계에서 제거하므로 정의되지 않은 키는 허용하지 않습니다.",
  "type": "object",
  "properties": {
    "item_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "이미지 내용 해시"
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "source_format": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "product_id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "dev",
        "test"
      ],
      "description": "제품 단위 고정 분할"
    },
    "image": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "sha256",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field_id": {
            "type": "string",
            "minLength": 1
          },
          "query_type": {
            "enum": [
              "A",
              "B",
              "C"
            ]
          },
          "gold": {
            "type": "string",
            "description": "포장에 인쇄된 값"
          },
          "evidence_document_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "field_id",
          "query_type",
          "gold"
        ],
        "additionalProperties": false
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "item_id",
    "dataset_version",
    "source_format",
    "domain",
    "product_id",
    "split",
    "image",
    "fields"
  ],
  "additionalProperties": false
}
