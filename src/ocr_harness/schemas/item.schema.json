{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "item",
  "description": "평가 항목 1건(이미지 1장). 촬영자 개인정보 키는 정의하지 않습니다.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "recordType": {
      "const": "item"
    },
    "itemId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "imageDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "datasetVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sourceFormat": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "productId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "split": {
      "enum": [
        "dev",
        "test"
      ]
    },
    "image": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fieldId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{1,63}$"
          },
          "queryType": {
            "enum": [
              "A",
              "B",
              "C"
            ]
          },
          "gold": {
            "type": "string"
          },
          "evidenceDocumentId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{1,63}$"
          }
        },
        "required": [
          "fieldId",
          "queryType",
          "gold"
        ],
        "additionalProperties": false
      }
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "queryId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{1,63}$"
          },
          "queryType": {
            "enum": [
              "A",
              "B",
              "C"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string"
          },
          "evidenceDocumentId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{1,63}$"
          }
        },
        "required": [
          "queryId",
          "queryType",
          "question",
          "answer"
        ],
        "additionalProperties": false
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]{1,63}$"
      }
    }
  },
  "required": [
    "schemaVersion",
    "recordType",
    "itemId",
    "imageDigest",
    "datasetVersion",
    "sourceFormat",
    "domain",
    "productId",
    "split",
    "image",
    "classification",
    "fields"
  ],
  "additionalProperties": false
}
