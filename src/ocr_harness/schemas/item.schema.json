{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dahun428-fx/ocr_test_repo/schemas/2.0.0/item.schema.json",
  "title": "item",
  "description": "평가 항목 1건(이미지 1장). 항목 1건의 형식에는 공통 표준이 없어 자체 정의입니다. 형식 규칙(id, semver, 해시)은 플랫폼 계약 0.2.0을 따릅니다. 정의하지 않은 키는 거부하므로 촬영자 개인정보가 들어올 수 없습니다.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "2.0.0",
      "description": "이 기록이 따르는 스키마 묶음의 버전."
    },
    "recordType": {
      "const": "item",
      "description": "기록 종류. JSONL 한 파일에 여러 종류가 섞여도 구분할 수 있게 합니다."
    },
    "itemId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$",
      "description": "항목 id. `img-` + 이미지 해시 앞 32자 (ocr_harness.ids.item_id)."
    },
    "imageDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "이미지 파일 내용의 SHA-256."
    },
    "datasetVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "이 항목이 속한 평가셋 버전 (SemVer). 동결한 버전은 바꾸지 않습니다."
    },
    "sourceFormat": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$",
      "description": "원본 라벨 형식의 이름. 형식마다 수집 어댑터를 따로 둡니다."
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$",
      "description": "데이터 영역 (예: medicine-packaging)."
    },
    "productId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$",
      "description": "제품 id. 분할과 통계(신뢰구간, 검정)의 군집 단위입니다."
    },
    "split": {
      "enum": [
        "dev",
        "test"
      ],
      "description": "개발용 또는 평가용. 같은 제품은 한쪽에만 들어갑니다."
    },
    "image": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "description": "가로 픽셀."
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "description": "세로 픽셀."
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false,
      "description": "이미지 크기. 그 밖의 촬영 정보는 받지 않습니다."
    },
    "classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "description": "데이터 분류 (플랫폼 계약의 분류 4종). 이용약관 확인 결과를 여기에 적습니다."
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fieldId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{1,63}$",
            "description": "필드 이름 (예: product-name, expiry)."
          },
          "queryType": {
            "enum": [
              "A",
              "B",
              "C"
            ],
            "description": "질의 유형. A: 포장에만 있는 값, B: 공개 근거로 교정할 수 있는 값, C: 둘 다 필요한 값. (이 연구의 자체 정의)"
          },
          "gold": {
            "type": "string",
            "description": "정답 값. 항상 포장에 인쇄된 글자입니다."
          },
          "evidenceDocumentId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{1,63}$",
            "description": "근거가 되는 knowledgeDocument의 documentId. 채점과 분석에만 쓰고 모델 입력에는 넣지 않습니다."
          }
        },
        "required": [
          "fieldId",
          "queryType",
          "gold"
        ],
        "additionalProperties": false
      },
      "description": "필드 추출 과제의 정답 목록."
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "queryId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{1,63}$",
            "description": "질의 id."
          },
          "queryType": {
            "enum": [
              "A",
              "B",
              "C"
            ],
            "description": "질의 유형. A: 포장에만 있는 값, B: 공개 근거로 교정할 수 있는 값, C: 둘 다 필요한 값. (이 연구의 자체 정의)"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "description": "질문."
          },
          "answer": {
            "type": "string",
            "description": "정답."
          },
          "evidenceDocumentId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{1,63}$",
            "description": "근거가 되는 knowledgeDocument의 documentId. 채점과 분석에만 쓰고 모델 입력에는 넣지 않습니다."
          }
        },
        "required": [
          "queryId",
          "queryType",
          "question",
          "answer"
        ],
        "additionalProperties": false
      },
      "description": "질의응답 과제의 질문과 정답 목록."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]{1,63}$"
      },
      "description": "분석용 표시 (예: 촬영 조건)."
    }
  },
  "required": [
    "schemaVersion",
    "recordType",
    "itemId",
    "imageDigest",
    "datasetVersion",
    "sourceFormat",
    "domain",
    "productId",
    "split",
    "image",
    "classification",
    "fields"
  ],
  "additionalProperties": false
}
