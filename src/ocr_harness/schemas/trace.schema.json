{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "trace",
  "description": "항목 × 조건 × 반복 한 번의 실행 기록.",
  "type": "object",
  "properties": {
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "item_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "condition": {
      "enum": [
        "C0",
        "C1",
        "C2",
        "C3",
        "C4",
        "CK"
      ]
    },
    "condition_version": {
      "type": "string",
      "minLength": 1
    },
    "repeat": {
      "type": "integer",
      "minimum": 0
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "description": "항목 · 조건 버전 · 반복 번호"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "ok",
        "error",
        "refused",
        "empty"
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "RATE_LIMITED",
            "UPSTREAM_TIMEOUT",
            "UPSTREAM_ERROR"
          ]
        },
        "message": {
          "type": "string"
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false
    },
    "steps": {
      "type": "object",
      "properties": {
        "ocr": {
          "type": "object",
          "properties": {
            "engine": {
              "type": "string",
              "minLength": 1
            },
            "engine_version": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string"
            },
            "duration_ms": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "engine",
            "engine_version",
            "text",
            "duration_ms"
          ],
          "additionalProperties": true
        },
        "retrieval": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            },
            "retriever_version": {
              "type": "string",
              "minLength": 1
            },
            "candidates": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "documentId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "score": {
                    "type": "number"
                  },
                  "rank": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "selected": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "documentId",
                  "score",
                  "rank",
                  "selected"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "query",
            "retriever_version",
            "candidates"
          ],
          "additionalProperties": true
        },
        "context": {
          "type": "object",
          "properties": {
            "template_id": {
              "type": "string",
              "minLength": 1
            },
            "order": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "component_tokens": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "required": [
            "template_id",
            "order",
            "component_tokens"
          ],
          "additionalProperties": true
        },
        "history": {
          "type": "object",
          "properties": {
            "candidates": {
              "type": "array"
            },
            "excluded": {
              "type": "array"
            }
          },
          "required": [
            "candidates",
            "excluded"
          ],
          "additionalProperties": true
        },
        "model_call": {
          "type": "object",
          "properties": {
            "gen_ai.request.model": {
              "type": "string",
              "minLength": 1
            },
            "prompt_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "raw_output": {
              "type": "string"
            },
            "duration_ms": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "gen_ai.request.model",
            "prompt_sha256",
            "raw_output",
            "duration_ms"
          ],
          "additionalProperties": true
        },
        "postprocess": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "check_only",
                "apply",
                "requery"
              ]
            },
            "rules": {
              "type": "array"
            },
            "output_before": {
              "type": "string"
            },
            "output_after": {
              "type": "string"
            }
          },
          "required": [
            "mode",
            "rules",
            "output_before",
            "output_after"
          ],
          "additionalProperties": true
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "trace_id",
    "run_id",
    "item_id",
    "dataset_version",
    "condition",
    "condition_version",
    "repeat",
    "idempotency_key",
    "started_at",
    "status"
  ],
  "additionalProperties": false,
  "if": {
    "properties": {
      "status": {
        "const": "error"
      }
    },
    "required": [
      "status"
    ]
  },
  "then": {
    "required": [
      "error"
    ]
  }
}
