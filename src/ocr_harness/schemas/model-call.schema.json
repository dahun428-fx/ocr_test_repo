{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "modelCall",
  "description": "비용 장부. 모델 호출 1회(재시도·보조 모델 포함)가 1줄입니다.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "recordType": {
      "const": "modelCall"
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "traceId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "spanId": {
      "type": "string",
      "pattern": "^[a-f0-9]{16}$"
    },
    "modelCallId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "itemId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "conditionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "modelRole": {
      "enum": [
        "main",
        "auxiliary"
      ]
    },
    "authRoute": {
      "enum": [
        "subscription_oauth",
        "api_key",
        "fake"
      ]
    },
    "provider": {
      "enum": [
        "external",
        "self-hosted"
      ]
    },
    "routeDecisionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "usage": {
      "type": "object",
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "inputTokens",
        "outputTokens"
      ],
      "additionalProperties": false
    },
    "attributes": {
      "type": "object",
      "properties": {
        "gen_ai.request.model": {
          "type": "string",
          "minLength": 1
        },
        "gen_ai.response.model": {
          "type": "string",
          "minLength": 1
        },
        "gen_ai.response.finish_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gen_ai.usage.cache_read.input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "gen_ai.usage.cache_write.input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "gen_ai.usage.reasoning.output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "gen_ai.usage.image.input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "ocr.usage.hidden_context_tokens": {
          "type": "integer"
        },
        "ocr.sdk.num_turns": {
          "type": "integer",
          "minimum": 0
        },
        "ocr.sdk.duration_api_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "gen_ai.request.model",
        "gen_ai.usage.cache_read.input_tokens",
        "gen_ai.usage.cache_write.input_tokens",
        "ocr.usage.hidden_context_tokens"
      ],
      "additionalProperties": false
    },
    "cost": {
      "type": "object",
      "properties": {
        "sdkReportedUsd": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0
            }
          ]
        },
        "computedUsd": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0
            }
          ]
        },
        "priceTableVersion": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sdkReportedUsd",
        "computedUsd",
        "priceTableVersion"
      ],
      "additionalProperties": false
    },
    "errorCode": {
      "enum": [
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "VALIDATION_ERROR",
        "NOT_FOUND",
        "CONFLICT",
        "NOT_IMPLEMENTED",
        "UPSTREAM_UNAVAILABLE",
        "UPSTREAM_TIMEOUT",
        "UPSTREAM_ERROR",
        "RATE_LIMITED",
        null
      ]
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schemaVersion",
    "recordType",
    "runId",
    "traceId",
    "spanId",
    "modelCallId",
    "itemId",
    "conditionId",
    "at",
    "attempt",
    "modelRole",
    "authRoute",
    "provider",
    "routeDecisionId",
    "usage",
    "attributes",
    "cost",
    "errorCode",
    "durationMs"
  ],
  "additionalProperties": false
}
