{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fieldScore",
  "description": "채점 1건. productId는 제품 단위 신뢰구간·검정용입니다.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "recordType": {
      "const": "fieldScore"
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "traceId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "scoreId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "itemId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "productId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "field"
            },
            "fieldId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]{1,63}$"
            }
          },
          "required": [
            "kind",
            "fieldId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "query"
            },
            "queryId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]{1,63}$"
            }
          },
          "required": [
            "kind",
            "queryId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "item"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "queryType": {
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "ocrMisread": {
      "type": "boolean"
    },
    "metric": {
      "type": "string",
      "minLength": 1
    },
    "score": {
      "type": "number"
    },
    "stage": {
      "enum": [
        "before_postprocess",
        "after_postprocess"
      ]
    },
    "datasetVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "agentVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "manifestDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "scorerVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  },
  "required": [
    "schemaVersion",
    "recordType",
    "runId",
    "traceId",
    "scoreId",
    "itemId",
    "productId",
    "target",
    "metric",
    "score",
    "stage",
    "datasetVersion",
    "agentVersion",
    "manifestDigest",
    "scorerVersion"
  ],
  "additionalProperties": false
}
